#include <stdio.h>

// Function to calculate T(n) = T(n/2) + 1
int recurrence(int n)
{
    if (n <= 1)
        return 1;   // Base case: T(1) = 1

    return recurrence(n / 2) + 1;
}

int main()
{
    int n;

    printf("Enter the value of n: ");
    scanf("%d", &n);

    printf("\nExpansion:\n");

    int temp = n;
    while (temp > 1)
    {
        printf("T(%d) = T(%d) + 1\n", temp, temp / 2);
        temp = temp / 2;
    }

    printf("T(1) = 1\n");

    int result = recurrence(n);

    printf("\nTotal value of T(%d) = %d\n", n, result);

    printf("\nTime Complexity: O(log n)\n");
    printf("Asymptotic Notation: Theta(log n)\n");

    return 0;
}
