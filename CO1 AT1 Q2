#include <stdio.h>

// Bubble Sort - O(n^2)
void bubbleSort(int arr[], int n)
{
    int i, j, temp;

    for(i = 0; i < n - 1; i++)
    {
        for(j = 0; j < n - i - 1; j++)
        {
            if(arr[j] > arr[j + 1])
            {
                temp = arr[j];
                arr[j] = arr[j + 1];
                arr[j + 1] = temp;
            }
        }
    }
}

// Merge function
void merge(int arr[], int left, int mid, int right)
{
    int i, j, k;
    int n1 = mid - left + 1;
    int n2 = right - mid;

    int L[n1], R[n2];

    for(i = 0; i < n1; i++)
        L[i] = arr[left + i];

    for(j = 0; j < n2; j++)
        R[j] = arr[mid + 1 + j];

    i = 0;
    j = 0;
    k = left;

    while(i < n1 && j < n2)
    {
        if(L[i] <= R[j])
            arr[k++] = L[i++];
        else
            arr[k++] = R[j++];
    }

    while(i < n1)
        arr[k++] = L[i++];

    while(j < n2)
        arr[k++] = R[j++];
}

// Merge Sort - O(n log n)
void mergeSort(int arr[], int left, int right)
{
    if(left < right)
    {
        int mid = (left + right) / 2;

        mergeSort(arr, left, mid);
        mergeSort(arr, mid + 1, right);

        merge(arr, left, mid, right);
    }
}

void printArray(int arr[], int n)
{
    int i;

    for(i = 0; i < n; i++)
        printf("%d ", arr[i]);

    printf("\n");
}

int main()
{
    int n, i;

    printf("Enter number of products: ");
    scanf("%d", &n);

    int arr1[n], arr2[n];

    printf("Enter product IDs:\n");

    for(i = 0; i < n; i++)
    {
        scanf("%d", &arr1[i]);
        arr2[i] = arr1[i];
    }

    bubbleSort(arr1, n);
    mergeSort(arr2, 0, n - 1);

    printf("\nSorted using Bubble Sort (O(n^2)):\n");
    printArray(arr1, n);

    printf("\nSorted using Merge Sort (O(n log n)):\n");
    printArray(arr2, n);

    printf("\nComplexity Comparison:\n");
    printf("Bubble Sort  : O(n^2)\n");
    printf("Merge Sort   : O(n log n)\n");

    printf("\nConclusion:\n");
    printf("Merge Sort is more efficient for large datasets because ");
    printf("its growth rate (n log n) is much slower than n^2.\n");
    printf("Hence, Merge Sort provides better scalability for ");
    printf("e-commerce systems handling a large number of products.\n");

    return 0;
}
